# Example Environment Variables
# Copy this file to .env.development or .env.production and fill in your values

# Server Configuration
SERVER_PORT=8080 (or your desired port)

# Database Configuration
DB_HOST=localhost (or your production DB host)
DB_PORT=5432 (or your production DB port)
DB_NAME=smart_appointment_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Redis Configuration
REDIS_HOST=localhost (or your production Redis host)
REDIS_PORT=6379 (or your production Redis port)

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_256_bits
JWT_EXPIRATION=86400000

# Mail Configuration (Optional)
MAIL_HOST=smtp.gmail.com (or your mail server)
MAIL_PORT=587 (or your mail server port)
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_mail_password

# Application Mode
SPRING_PROFILES_ACTIVE=development (or production)
